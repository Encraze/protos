APP_ENVIRONMENT=dev
APP_DATABASE_URL=postgresql+asyncpg://protos:protos@localhost:5432/protos
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

APP_AUTH_MODE=stub
APP_AUTH_SEED=true
APP_SESSION_SECRET=dev-secret-change-me-min-32-chars-aaaaaa
APP_FRONTEND_URL=http://localhost:8080
# Externally-visible base URL of the api as the browser sees it.
# Empty when no reverse proxy; "http://localhost:8080/api" behind the docker-compose nginx.
APP_API_PUBLIC_URL=http://localhost:8080/api

# Real provider credentials (only used when APP_AUTH_MODE=real):
# APP_GOOGLE_CLIENT_ID=
# APP_GOOGLE_CLIENT_SECRET=
# APP_GITHUB_CLIENT_ID=
# APP_GITHUB_CLIENT_SECRET=
